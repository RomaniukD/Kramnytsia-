{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/",
      "methods": ["POST"],
      "dest": "/api/payment-return.js"
    },
    {
      "src": "/payment-success\\.html",
      "methods": ["POST"],
      "dest": "/api/payment-return.js"
    },
    {
      "src": "/payment-failed\\.html",
      "methods": ["POST"],
      "dest": "/api/payment-return.js"
    }
  ]
}
